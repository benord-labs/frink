# Optional — `bun run dev`, `bun run build` and `bun run test:run` need none of these.
# Copy to .env (gitignored) to override.

# Webhook base for `bun run dev`: unset = Frink's public relay, empty = local-only, or your own relay/.
# FRINK_WEBHOOK_BASE_URL=

# Telemetry for your own packaged builds, baked in at build time. Unset = no PostHog or Sentry.
# MAIN_VITE_POSTHOG_KEY=
# MAIN_VITE_SENTRY_DSN=
# RENDERER_VITE_SENTRY_DSN=

# Auto-update feed for your own packaged builds (a generic electron-updater feed, https only).
# Unset = auto-update is off. Forks: point this at your own feed, never Frink's.
# MAIN_VITE_UPDATE_FEED_URL=

# Maintainer release credentials (signing, notarization, upload) are listed in docs/RELEASING.md.
