{
  "expo": {
    "name": "Frink",
    "slug": "frink-mobile",
    "scheme": "frink-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.frink.mobile",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing code shown by Frink on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        { "photosPermission": "Attach the photos you choose to your messages to Frink." }
      ],
      "expo-document-picker",
      "expo-font"
    ],
    "web": { "bundler": "metro", "favicon": "./assets/icon.png" },
    "extra": { "eas": { "projectId": "fea3042a-34ec-46a8-8979-ca5998710dbf" } },
    "owner": "norvalbv"
  }
}
