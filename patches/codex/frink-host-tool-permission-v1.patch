+#[tokio::test]
+#[serial_test::serial(frink_host_permissions)]
+async fn frink_capability_sends_a_hook_allow_to_the_reviewer() -> anyhow::Result<()> {
+    let _capability = FrinkCapability::set(/*enabled*/ true);
+    let approval = HookedApproval::new("frink", serde_json::json!({ "behavior": "allow" })).await?;
+    let request_approval = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        approval
+            .session
+            .request_approval(approval.action, approval.context),
+    );
+    tokio::pin!(request_approval);
+    let request = loop {
+        tokio::select! {
+            biased;
+            result = &mut request_approval => {
+                panic!("expected the hook allow to reach the reviewer, got {result:?}")
+            }
+            event = approval.events.recv() => {
+                if let codex_protocol::protocol::EventMsg::ExecApprovalRequest(request) = event?.msg {
+                    break request;
+                }
+            }
+        }
+    };
+    assert!(
+        approval.hook_log.exists(),
+        "the PermissionRequest hook should still run"
+    );
+    approval
+        .session
+        .notify_approval(&request.call_id, ReviewDecision::denied("reviewer said no"))
+        .await;
+
+    assert!(matches!(
+        request_approval.await?,
+        Err(ToolError::Rejected(rejection)) if rejection == "reviewer said no"
+    ));
+    Ok(())
+}
