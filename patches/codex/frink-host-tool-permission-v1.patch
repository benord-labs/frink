+enum FrinkDirectMcpRoute {
+    Transport,
+    Guardian,
+    Reject(String),
+}
+
+fn frink_direct_mcp_route(decision: Option<FrinkHostPermissionDecision>) -> FrinkDirectMcpRoute {
+    match decision {
+        None | Some(FrinkHostPermissionDecision::Allow) => FrinkDirectMcpRoute::Transport,
+        Some(FrinkHostPermissionDecision::Defer) => FrinkDirectMcpRoute::Guardian,
+        Some(FrinkHostPermissionDecision::Deny(reason)) => FrinkDirectMcpRoute::Reject(reason),
+    }
