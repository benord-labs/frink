+                cancellation_token: None,
+                call_id: call_id.to_string(),
+                tool_name: ToolName::plain(tool_name),
+                strict_auto_review: true,
+                approval_reason: None,
+                retry_reason: None,
+                network_approval_context: None,
+            };
+            sess.request_approval(action, approval_context)
+                .await
+                .map(|_| ())
+                .map_err(|error| match error {
+                    ToolError::Rejected(reason) => {
+                        anyhow::anyhow!("MCP tool call denied by automated review: {reason}")
+                    }
+                    ToolError::Codex(_) => {
+                        anyhow::anyhow!("MCP tool call cancelled by automated review")
+                    }
+                })
+        }
+    }
