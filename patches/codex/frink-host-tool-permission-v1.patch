+    let approval = HookedApproval::new("frink", serde_json::json!({ "behavior": "allow" })).await?;
+    let request_approval = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        approval
+            .session
+            .request_approval(approval.action, approval.context),
+    );
+    tokio::pin!(request_approval);
+    let request = loop {
+        tokio::select! {
+            biased;
+            result = &mut request_approval => {
+                panic!("expected the hook allow to reach the reviewer, got {result:?}")
+            }
+            event = approval.events.recv() => {
+                if let codex_protocol::protocol::EventMsg::ExecApprovalRequest(request) = event?.msg {
+                    break request;
+                }
+            }
+        }
+    };
+    assert!(
+        approval.hook_log.exists(),
