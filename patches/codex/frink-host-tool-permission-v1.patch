+/// Sets the process-wide Frink host-permission capability and clears it when dropped.
+struct FrinkCapability;
+
+impl FrinkCapability {
+    fn set(enabled: bool) -> Self {
+        crate::frink_host_permissions::set_enabled(enabled);
+        Self
+    }
+}
+
+impl Drop for FrinkCapability {
+    fn drop(&mut self) {
+        crate::frink_host_permissions::set_enabled(false);
+    }
+}
