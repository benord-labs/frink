+    // Codex gives its runtime threads this stack; the native approval path outgrows the default
+    // test stack in a debug build.
+    std::thread::Builder::new()
+        .stack_size(codex_async_utils::THREAD_STACK_SIZE_BYTES)
+        .spawn(move || -> anyhow::Result<()> {
+            tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()?
+                .block_on(async {
+                    let _capability = FrinkCapability::set(capability_enabled);
+                    let approval = HookedApproval::new(
