+#[derive(Debug, PartialEq, Eq)]
+struct FrinkMcpTransportIdentity {
+    thread_id: String,
+    turn_id: String,
+    call_id: String,
+}
+
+fn frink_mcp_transport_identity(
+    meta: Option<&serde_json::Value>,
+    required: bool,
+    expected_thread_id: &str,
+) -> anyhow::Result<Option<FrinkMcpTransportIdentity>> {
+    if !required {
+        return Ok(None);
+    }
+    let meta = meta
+        .and_then(serde_json::Value::as_object)
+        .ok_or_else(|| anyhow::anyhow!("Frink MCP transport requires object metadata"))?;
+    let required_string = |key: &str| {
+        meta.get(key)
+            .and_then(serde_json::Value::as_str)
+            .filter(|value| !value.is_empty())
+            .map(str::to_string)
+            .ok_or_else(|| anyhow::anyhow!("Frink MCP transport requires _meta.{key}"))
+    };
+    let identity = FrinkMcpTransportIdentity {
+        thread_id: required_string("threadId")?,
+        turn_id: required_string("turnId")?,
+        call_id: required_string("callId")?,
+    };
+    if identity.thread_id != expected_thread_id {
+        anyhow::bail!("Frink MCP transport thread identity mismatch");
+    }
+    Ok(Some(identity))
+}
+
+async fn run_mcp_transport_unless_cancelled<T>(
+    cancellation_token: &CancellationToken,
+    transport: impl Future<Output = anyhow::Result<T>>,
+) -> anyhow::Result<T> {
+    tokio::select! {
+        biased;
+        _ = cancellation_token.cancelled() => {
+            anyhow::bail!("Frink MCP transport turn was cancelled before dispatch")
+        }
+        result = transport => result,
+    }
+}
