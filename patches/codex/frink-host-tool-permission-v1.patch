+struct HookedApproval {
+    session: Arc<Session>,
+    action: ApprovalAction,
+    context: ApprovalContext,
+    events: async_channel::Receiver<codex_protocol::protocol::Event>,
+    hook_log: PathBuf,
+}
+
+impl HookedApproval {
+    /// A user-reviewed command approval on a turn whose trusted PermissionRequest hook
+    /// answers `hook_decision`.
+    async fn new(client_name: &str, hook_decision: serde_json::Value) -> anyhow::Result<Self> {
+        use anyhow::Context;
+        use std::os::unix::fs::PermissionsExt;
+
+        let (session, mut turn, events) = make_session_and_context_with_rx().await;
+        Arc::get_mut(&mut turn)
+            .context("turn is uniquely owned")?
+            .app_server_client_name = Some(client_name.to_string());
+        let codex_home = &turn.config.codex_home;
+        std::fs::create_dir_all(codex_home)?;
+        let script_path = codex_home.join("permission_request_hook.sh");
+        let hook_log = codex_home
+            .join("permission_request_hook_log.json")
+            .to_path_buf();
+        let response = serde_json::json!({
+            "hookSpecificOutput": {
+                "hookEventName": "PermissionRequest",
+                "decision": hook_decision,
+            },
+        });
+        std::fs::write(
+            &script_path,
+            format!(
+                "#!/bin/sh\ncat > {log}\nprintf '%s\\n' {response}\n",
+                log = shlex::try_quote(hook_log.to_string_lossy().as_ref())?,
+                response = shlex::try_quote(&response.to_string())?,
+            ),
+        )?;
+        std::fs::set_permissions(&script_path, std::fs::Permissions::from_mode(0o755))?;
+        std::fs::write(
+            codex_home.join("hooks.json"),
+            serde_json::json!({
+                "hooks": {
+                    "PermissionRequest": [{
+                        "hooks": [{
+                            "type": "command",
+                            "command": script_path.display().to_string(),
+                        }]
+                    }]
+                }
+            })
+            .to_string(),
+        )?;
+        let hook_list = codex_hooks::list_hooks(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            config_layer_stack: Some(turn.config.config_layer_stack.clone()),
+            ..Default::default()
+        });
+        assert_eq!(hook_list.hooks.len(), 1);
+        let trusted_config_layer_stack = turn.config.config_layer_stack.with_user_config(
+            &codex_home.join(codex_config::CONFIG_TOML_FILE),
+            serde_json::from_value(serde_json::json!({
+                "hooks": {
+                    "state": {
+                        hook_list.hooks[0].key.clone(): {
+                            "trusted_hash": hook_list.hooks[0].current_hash.clone(),
+                        },
+                    },
+                },
+            }))?,
+        )?;
+        let mut shell_args = session
+            .user_shell()
+            .derive_exec_args("", /*use_login_shell*/ false);
+        let shell_program = shell_args.remove(0);
+        let _ = shell_args.pop();
+        let hooks = session.hooks().reconfigured(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            config_layer_stack: Some(trusted_config_layer_stack),
+            shell_program: Some(shell_program),
+            shell_args,
+            ..Default::default()
+        });
+        session.services.hooks.store(Arc::new(hooks));
+        *session.active_turn.lock().await = Some(crate::state::ActiveTurn::default());
+
+        let mut review_context = GuardianReviewContext::from(&turn);
+        review_context.approval_policy = AskForApproval::OnRequest;
+        review_context.approvals_reviewer = ApprovalsReviewer::User;
+        let context = ApprovalContext {
+            review_context,
+            cancellation_token: None,
+            call_id: "hooked-approval".to_string(),
+            tool_name: ToolName::plain("exec_command"),
+            strict_auto_review: false,
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        };
+        let action = ApprovalAction::ExecCommand {
+            id: context.call_id.clone(),
+            environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+            command: vec!["npm".to_string(), "install".to_string()],
+            hook_command: "npm install".to_string(),
+            cwd: PathUri::from_abs_path(&AbsolutePathBuf::try_from(std::env::temp_dir())?),
+            sandbox_permissions: SandboxPermissions::RequireEscalated,
+            additional_permissions: None,
+            justification: None,
+            tty: false,
+            proposed_execpolicy_amendment: None,
+        };
+        Ok(Self {
+            session,
+            action,
+            context,
+            events,
+            hook_log,
+        })
+    }
+
+    /// Runs the approval to completion, failing if the reviewer is asked instead.
+    async fn resolve_without_reviewer(self) -> anyhow::Result<Result<ReviewDecision, ToolError>> {
+        let result = tokio::time::timeout(
+            std::time::Duration::from_secs(10),
+            self.session.request_approval(self.action, self.context),
+        )
+        .await?;
+        assert!(
+            self.hook_log.exists(),
+            "the PermissionRequest hook should run"
+        );
+        while let Ok(event) = self.events.try_recv() {
+            assert!(
+                !matches!(
+                    event.msg,
+                    codex_protocol::protocol::EventMsg::ExecApprovalRequest(_)
+                ),
+                "the reviewer should not be asked"
+            );
+        }
+        Ok(result)
+    }
+}
