+            frink_mcp_permission_tool_name(server, tool),
+            arguments
+                .clone()
+                .unwrap_or_else(|| JsonValue::Object(serde_json::Map::new())),
+            Some(turn_context.config.cwd.clone()),
+            Vec::new(),
+            Some(FrinkMcpIdentity {
+                server: server.to_string(),
+                tool: tool.to_string(),
+            }),
+        )
+        .await;
+    match frink_direct_mcp_route(decision) {
+        FrinkDirectMcpRoute::Transport => Ok(()),
+        FrinkDirectMcpRoute::Reject(reason) => {
+            anyhow::bail!("MCP tool call denied by Frink permissions: {reason}")
+        }
+        FrinkDirectMcpRoute::Guardian => {
+            let tool_name = frink_mcp_permission_tool_name(server, tool);
+            let action = ApprovalAction::McpToolCall {
