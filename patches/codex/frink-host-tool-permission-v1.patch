+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+pub(crate) const RESPONSE_TIMEOUT: Duration = Duration::from_secs(600);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum FrinkHostPermissionDecision {
+    Allow,
+    Deny(String),
+    Defer,
+}
+
+pub fn set_enabled(enabled: bool) {
+    ENABLED.store(enabled, Ordering::Release);
+}
+
+pub(crate) fn enabled_for(client_name: Option<&str>) -> bool {
+    client_name == Some("frink") && ENABLED.load(Ordering::Acquire)
+}
