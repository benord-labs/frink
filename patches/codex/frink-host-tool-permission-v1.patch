+async fn authorize_resource_transport(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    call_id: &str,
+    server: &str,
+    tool: &str,
+    arguments: Option<Value>,
+) -> Result<CancellationToken, FunctionCallError> {
+    crate::mcp_tool_call::authorize_frink_mcp_transport(
+        session, turn, call_id, server, tool, arguments,
+    )
+    .await
+    .map_err(|error| FunctionCallError::RespondToModel(format!("{error:#}")))?;
+
+    let Some((active_turn, cancellation_token)) = session
+        .active_turn_context_and_cancellation_token_for_sub_id(&turn.sub_id)
+        .await
+    else {
+        return Err(FunctionCallError::RespondToModel(
+            "MCP resource operation turn ended before dispatch".to_string(),
+        ));
+    };
+    if !Arc::ptr_eq(&active_turn, turn) || cancellation_token.is_cancelled() {
+        return Err(FunctionCallError::RespondToModel(
+            "MCP resource operation turn ended before dispatch".to_string(),
+        ));
+    }
+    Ok(cancellation_token)
+}
+
+async fn run_resource_transport_unless_cancelled<T>(
+    cancellation_token: &CancellationToken,
+    transport: impl Future<Output = T>,
+) -> Result<T, FunctionCallError> {
+    tokio::select! {
+        biased;
+        _ = cancellation_token.cancelled() => Err(FunctionCallError::RespondToModel(
+            "MCP resource operation cancelled before dispatch".to_string(),
+        )),
+        result = transport => Ok(result),
+    }
+}
