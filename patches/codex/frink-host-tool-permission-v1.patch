+fn frink_patch_effects(action: &ApplyPatchAction) -> Vec<FrinkPatchEffect> {
+    action
+        .changes()
+        .iter()
+        .map(|(path, change)| match change {
+            ApplyPatchFileChange::Add { .. } => FrinkPatchEffect {
+                operation: "add".to_string(),
+                path: frink_patch_path(path),
+                destination: None,
+            },
+            ApplyPatchFileChange::Delete { .. } => FrinkPatchEffect {
+                operation: "delete".to_string(),
+                path: frink_patch_path(path),
+                destination: None,
+            },
+            ApplyPatchFileChange::Update { move_path, .. } => FrinkPatchEffect {
+                operation: if move_path.is_some() {
+                    "move"
+                } else {
+                    "update"
+                }
+                .to_string(),
+                path: frink_patch_path(path),
+                destination: move_path.as_ref().map(frink_patch_path),
+            },
+        })
+        .collect()
+}
+
+fn frink_patch_path(path: &PathUri) -> String {
+    path.inferred_native_path_string()
