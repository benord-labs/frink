+impl HookedApproval {
+    /// A user-reviewed command approval on a turn whose trusted PermissionRequest hook
+    /// answers `hook_decision`.
+    async fn new(client_name: &str, hook_decision: serde_json::Value) -> anyhow::Result<Self> {
+        use anyhow::Context;
+        use std::os::unix::fs::PermissionsExt;
+
+        let (session, mut turn, events) = make_session_and_context_with_rx().await;
+        Arc::get_mut(&mut turn)
+            .context("turn is uniquely owned")?
+            .app_server_client_name = Some(client_name.to_string());
+        let codex_home = &turn.config.codex_home;
+        std::fs::create_dir_all(codex_home)?;
+        let script_path = codex_home.join("permission_request_hook.sh");
+        let hook_log = codex_home
+            .join("permission_request_hook_log.json")
+            .to_path_buf();
