{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/{dev,skills,testing}/*.{js,mjs,ts}",
        "scripts/binaries/*.mjs",
        "scripts/perf/*.mjs",
        "scripts/publish/*.mjs",
        "scripts/plugin-catalog/generate.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["babel-plugin-react-compiler", "path-browserify"]
    },
    "relay": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "live-activity-forwarder": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  },
  "ignore": ["mobile/**"],
  "ignoreBinaries": ["mkfifo", "node-gyp"],
  "ignoreIssues": {
    "src/renderer/features/agents/ui/agent-task-tools.tsx": ["exports"],
    "src/renderer/lib/hotkeys/shortcut-registry.ts": ["exports"]
  }
}
